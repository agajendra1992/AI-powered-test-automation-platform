<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Nightly: all scenarios except @quarantine.
  Scenario-level parallelism comes only from the Cucumber DataProvider; this suite never
  sets parallel="...". Thread count: data-provider-thread-count below, or -Dthreads=N via Maven.
  Narrow further with -Dcucumber.filter.tags="...".
-->
<suite name="Regression" data-provider-thread-count="4" verbose="1">
    <listeners>
        <listener class-name="io.qaplatform.core.listeners.ExecutionListener"/>
        <listener class-name="io.qaplatform.core.listeners.RetryTransformer"/>
    </listeners>
    <test name="Regression scenarios">
        <classes>
            <class name="io.qaplatform.bdd.runners.RegressionRunner"/>
        </classes>
    </test>
</suite>
