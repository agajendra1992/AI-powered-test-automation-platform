<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Contract tests (Pact). The consumer test writes target/pacts/*.json; the provider test replays it
  against api.base.url. Order matters, so the suite runs its tests in sequence.
  The provider must run with PACT_PROVIDER_STATES=1 (docs/CONTRACT_TESTING.md).
-->
<suite name="Contract" preserve-order="true" verbose="1">
    <test name="Consumer pact">
        <classes>
            <class name="io.qaplatform.contract.QaShopApiConsumerPactTest"/>
        </classes>
    </test>
    <test name="Provider verification">
        <classes>
            <class name="io.qaplatform.contract.QaShopApiProviderPactTest"/>
        </classes>
    </test>
</suite>
