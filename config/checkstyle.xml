<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Project quality gate. Focused on the framework rules from the platform spec rather than
  formatting taste: no JUnit / Selenium / Rest Assured, no hard sleeps, no swallowed exceptions.
  A justified exception is written as:  // CHECKSTYLE.OFF: reason ... // CHECKSTYLE.ON
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="FileTabCharacter"/>
    <module name="SuppressWithPlainTextCommentFilter">
        <property name="offCommentFormat" value="CHECKSTYLE.OFF\: .+"/>
        <property name="onCommentFormat" value="CHECKSTYLE.ON"/>
    </module>
    <module name="TreeWalker">
        <module name="IllegalImport">
            <property name="illegalPkgs" value="org.junit, junit, org.openqa.selenium, io.restassured"/>
            <message key="import.illegal"
                     value="''{0}'' is not allowed: TestNG is the runner, Playwright the only UI/API engine."/>
        </module>
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="EmptyCatchBlock"/>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="Thread\.sleep\(|waitForTimeout\("/>
            <property name="message" value="Hard sleeps are banned; wait for a real condition (web-first assertion, waitForResponse, waitForURL)."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Use SLF4J logging instead of System.out/err."/>
        </module>
    </module>
</module>
